* text=auto

# 源码按文本处理（保证跨平台 diff 可读）
*.v       text
*.vh      text
*.vhd     text
*.tcl     text
*.cfg     text
*.prj     text
*.al      text
*.adc     text
*.sdc     text
*.md      text
*.py      text

# TD 生成的报告：不做行尾规范化，保证与工具原始输出逐字节一致
*.rpt     -text -diff
*.log     -text -diff
*.qor     -text -diff
*.area    -text -diff

# 二进制资产（禁止行尾转换与 diff）
*.bit     binary
*.BMP     binary
*.WAV     binary
*.png     binary
*.jpg     binary
*.pdf     binary
*.docx    binary
*.db      binary
